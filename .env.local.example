NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# --- Optional: allow OTHER sites to call /api/chat (CORS) ---
# Comma-separated origins that may embed this chatbot backend cross-origin.
# Unset = same-origin only (safe default for the portfolio site itself).
# ALLOWED_ORIGINS=https://my-other-site.vercel.app,https://another.site

# --- Optional: /api/chat rate limit (in-memory, per instance) ---
# Defaults are sensible for a portfolio site; uncomment to override.
# RATE_LIMIT_WINDOW_SEC=60   # length of the sliding window, in seconds
# RATE_LIMIT_MAX=15          # max requests per IP within that window

# --- Optional: /api/chat DAILY cap (Supabase-backed; run supabase/rate-limit.sql first) ---
# Survives serverless cold starts, unlike the in-memory burst limit above.
# DAILY_LIMIT_PER_IP=25      # max questions per visitor (IP) per day (default 25)
# DAILY_LIMIT_GLOBAL=250     # max questions across ALL visitors per day (0 = off)
# DAILY_LIMIT_SALT=change-me # salt used when hashing IPs before storing them
